# RockGuard AI - frontend environment template
# Copy to `.env` if you need to override the defaults. Never commit real keys.

# Leave blank in development: Vite proxies /api to http://127.0.0.1:8000.
#
# In production this MUST point at the deployed backend, because Vercel serves
# static files only and has no proxy to forward /api to. Set it as an
# Environment Variable in the Vercel project settings, e.g.
#   VITE_API_BASE=https://rockguard-api.onrender.com
#
# Note: Vite inlines env vars at BUILD time, so changing this in Vercel
# requires a redeploy to take effect.
VITE_API_BASE=
