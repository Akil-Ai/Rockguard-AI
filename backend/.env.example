# RockGuard AI - backend environment template
# Copy to `.env` and edit. NEVER commit the real .env file.

APP_NAME="RockGuard AI"
ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API.
# In production add your deployed frontend URL, e.g. https://rockguard-ai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Regex for additional allowed origins. Defaults to the project's own Vercel
# preview deployments. Set to an empty string to disable pattern matching.
CORS_ORIGIN_REGEX=^https://rockguard-ai(-[a-z0-9-]+)?\.vercel\.app$

# SQLite by default. For PostgreSQL/Supabase use e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/rockguard
#
# NOTE on free-tier hosting: the container filesystem is ephemeral, so a SQLite
# database is wiped on every restart/redeploy. That is fine for this demo — the
# simulator refills history within seconds — but set DATABASE_URL to a managed
# Postgres instance if you need readings to survive a restart.
DATABASE_URL=sqlite:///./data/rockguard.db

# Seconds between simulated IoT sensor ticks
SENSOR_TICK_SECONDS=5

# Risk score thresholds (0-100)
THRESHOLD_MEDIUM=35
THRESHOLD_HIGH=60
THRESHOLD_CRITICAL=80

# Minutes before an identical zone alert can be raised again
ALERT_COOLDOWN_MINUTES=2

# --- Outbound notification providers (OPTIONAL) ---
# Leave blank to run in SIMULATED mode: alerts are logged to the database
# and shown in the UI, but no real SMS/WhatsApp message is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_RECIPIENTS=
